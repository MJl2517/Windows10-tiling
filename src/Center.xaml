<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rose Pine Desktop · Центр управления" Width="1080" Height="810" MinWidth="920" MinHeight="660"
        Background="#191724" Foreground="#e0def4" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#e0def4"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#908caa"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="21"/></Style>
    <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1f1d2e"/><Setter Property="BorderBrush" Value="#403d52"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#e0def4"/><Setter Property="Background" Value="#26233a"/><Setter Property="BorderBrush" Value="#524f67"/>
      <Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,6,10,0"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
        </Border><ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#403d52"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#9ccfd8"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#524f67"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#26233a"/><Setter Property="BorderBrush" Value="#c4a7e7"/><Setter Property="Foreground" Value="#c4a7e7"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#eb6f92"/><Setter Property="BorderBrush" Value="#eb6f92"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#191724"/><Setter Property="Foreground" Value="#e0def4"/><Setter Property="CaretBrush" Value="#e0def4"/><Setter Property="SelectionBrush" Value="#524f67"/>
      <Setter Property="BorderBrush" Value="#524f67"/><Setter Property="Padding" Value="10,9"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#9ccfd8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#e0def4"/><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border x:Name="Box" Width="19" Height="19" VerticalAlignment="Top" Background="#191724" BorderBrush="#6e6a86" BorderThickness="1" CornerRadius="4"><Path x:Name="Tick" Data="M 4,9 L 8,13 L 15,5" Stroke="#191724" StrokeThickness="2" Visibility="Collapsed"/></Border>
        <ContentPresenter Grid.Column="1" Margin="11,0,0,0" RecognizesAccessKey="True"/>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#c4a7e7"/><Setter TargetName="Box" Property="BorderBrush" Value="#c4a7e7"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#9ccfd8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#9ccfd8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#908caa"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Item" Padding="16,13" Margin="0,3" CornerRadius="7" Background="Transparent" BorderThickness="2,0,0,0" BorderBrush="Transparent"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#26233a"/><Setter Property="Foreground" Value="#e0def4"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#26233a"/><Setter TargetName="Item" Property="BorderBrush" Value="#c4a7e7"/><Setter Property="Foreground" Value="#c4a7e7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="#9ccfd8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#191724"/><Setter Property="Foreground" Value="#e0def4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#26233a"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#403d52"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#26233a"/><Setter Property="Foreground" Value="#908caa"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="DataGridRow"><Setter Property="Background" Value="#1f1d2e"/><Setter Property="Foreground" Value="#e0def4"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#26233a"/></Trigger></Style.Triggers></Style>
    <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#403d52"/><Setter Property="Foreground" Value="#e0def4"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ContextMenu"><Setter Property="Background" Value="#26233a"/><Setter Property="Foreground" Value="#e0def4"/><Setter Property="BorderBrush" Value="#524f67"/><Setter Property="Padding" Value="6"/></Style>
    <Style TargetType="MenuItem"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="12,9"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#403d52"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#524f67" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="9"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#26233a"/><Setter Property="Foreground" Value="#e0def4"/><Setter Property="BorderBrush" Value="#524f67"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="Actions">
      <Border Width="208" HorizontalAlignment="Left" Background="#1f1d2e" BorderBrush="#403d52" BorderThickness="0,0,1,0"/>
      <TabControl x:Name="Tabs" SelectedIndex="0" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" Padding="0">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid Margin="18,26,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="10,0,0,32"><TextBlock Text="rose pine" FontSize="25" FontWeight="SemiBold" Foreground="#c4a7e7"/><TextBlock Text="DESKTOP" FontSize="11" Foreground="#908caa" Margin="1,4,0,0"/></StackPanel>
            <TabPanel x:Name="HeaderPanel" Grid.Row="1" IsItemsHost="True" KeyboardNavigation.TabIndex="0"/>
            <TextBlock Grid.Row="3" Text="Центр управления" Foreground="#6e6a86" Margin="10,0,0,0"/>
          </Grid><ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent" Margin="28,26,28,0"/>
        </Grid></ControlTemplate></TabControl.Template>
        <TabItem Header="Обновления">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,12">
            <TextBlock Text="Обновления" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Версии окружения и последние изменения." Style="{StaticResource Hint}" Margin="0,7,0,24"/>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Установленная версия" Style="{StaticResource Hint}"/><TextBlock x:Name="Version" FontSize="22" FontWeight="SemiBold" Foreground="#9ccfd8" Margin="0,5,0,16"/>
              <TextBlock x:Name="UpdateTitle" Text="Проверка ещё не выполнялась" Style="{StaticResource Heading}"/>
              <TextBlock x:Name="Update" Text="Проверь наличие новой версии перед установкой." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
              <WrapPanel><Button x:Name="CheckUpdates" Content="Проверить обновления" Style="{StaticResource Primary}"/><Button x:Name="InstallUpdate" Content="Установить обновление" IsEnabled="False"/></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Источник выпусков" Style="{StaticResource Heading}"/>
              <TextBlock x:Name="SourceStatus" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
              <TextBlock Text="Адрес манифеста или путь к локальному файлу" Margin="0,0,0,7"/><TextBox x:Name="Feed" AutomationProperties.Name="Источник обновлений"/>
              <WrapPanel><Button x:Name="SaveSource" Content="Сохранить источник" IsEnabled="False"/><Button x:Name="PickSource" Content="Выбрать файл…"/></WrapPanel>
              <TextBlock Text="Обновления устанавливаются только по твоей команде. Личные настройки сохраняются." Style="{StaticResource Hint}" Margin="0,16,0,0"/>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Настройки">
          <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,8">
              <TextBlock Text="Настройки" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Выбери, как работает твоё окружение." Style="{StaticResource Hint}" Margin="0,7,0,24"/>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Компоненты" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="Desktop" Content="Управление окнами и верхняя панель" ToolTip="GlazeWM и панель Rosé Pine"/><CheckBox x:Name="Files" Content="Файловый менеджер Yazi и терминал"/><CheckBox x:Name="Borders" Content="Обводка активного окна"/>
                <Button x:Name="StartDesktop" Content="Запустить окружение" HorizontalAlignment="Left" ToolTip="Запустить включённые компоненты с сохранёнными настройками"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Запуск и оформление" Style="{StaticResource Heading}"/>
                <CheckBox x:Name="Auto" Content="Запускать окружение при входе в Windows"/><CheckBox x:Name="Check" Content="Проверять обновления при входе в Windows"/>
                <CheckBox x:Name="Hide" Content="Скрывать нижнюю панель Windows"/><TextBlock Text="Клавиша Win показывает и скрывает панель. Сочетания Win с другими клавишами продолжают работать." Style="{StaticResource Hint}" Margin="30,0,0,8"/>
                <CheckBox x:Name="Cursor" Content="Использовать курсор Bibata Modern Ice"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Браузер" Style="{StaticResource Heading}"/><TextBlock x:Name="BrowserLabel" Foreground="#9ccfd8" Margin="0,2,0,10"/>
                <TextBox x:Name="Browser" IsReadOnly="True" FontSize="12" AutomationProperties.Name="Выбранный браузер"/><Button x:Name="Browse" Content="Выбрать браузер…" HorizontalAlignment="Left"/>
              </StackPanel></Border>
              <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Рабочие пространства" Style="{StaticResource Heading}"/><TextBlock x:Name="MonitorHint" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
                <DataGrid x:Name="Spaces" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" Background="#1f1d2e" Foreground="#e0def4" BorderThickness="0" SelectionUnit="Cell" MinRowHeight="36">
                  <DataGrid.Columns><DataGridTextColumn Header="Клавиши" Binding="{Binding shortcut}" IsReadOnly="True" Width="110"/><DataGridTextColumn Header="Название" Binding="{Binding label}" Width="*"/><DataGridTextColumn Header="Монитор" Binding="{Binding displayMonitor}" Width="110"/></DataGrid.Columns>
                </DataGrid>
              </StackPanel></Border>
            </StackPanel></ScrollViewer>
            <Border Grid.Row="1" BorderBrush="#403d52" BorderThickness="0,1,0,0" Padding="0,14,0,18"><DockPanel LastChildFill="True"><Button x:Name="SaveSettings" Content="Сохранить настройки" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="18,0,0,0" IsEnabled="False"/><TextBlock x:Name="SettingsState" Text="Все изменения сохранены" Foreground="#908caa" VerticalAlignment="Center"/></DockPanel></Border>
          </Grid>
        </TabItem>
        <TabItem Header="Горячие клавиши">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel><TextBlock Text="Горячие клавиши" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Запуск приложений, управление окнами и пространствами." Style="{StaticResource Hint}" Margin="0,7,0,20"/>
              <TextBlock Text="Поиск по действию или сочетанию" Margin="0,0,0,7"/><TextBox x:Name="HotkeySearch" AutomationProperties.Name="Поиск горячих клавиш" Margin="0,0,0,14"/>
              <TextBlock Text="Дважды нажми на сочетание и введи его название: Alt+E или Alt+Ctrl+←. Несколько вариантов разделяй точкой с запятой; пустое поле отключает действие." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
              <TextBlock Text="Одинаковые физические клавиши в EN/RU. Назначения сохраняются при обновлении и появляются в подсказке." Style="{StaticResource Hint}" Margin="0,0,0,16"/>
            </StackPanel>
            <Grid Grid.Row="1">
              <DataGrid x:Name="Hotkeys" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False" CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" Background="#1f1d2e" Foreground="#e0def4" BorderThickness="0" SelectionUnit="FullRow" SelectionMode="Single" MinRowHeight="40">
                <DataGrid.Columns><DataGridTextColumn Header="Раздел" Binding="{Binding group}" IsReadOnly="True" Width="112"/><DataGridTextColumn Header="Действие" Binding="{Binding title}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Сочетания" Binding="{Binding text}" Width="240"/></DataGrid.Columns>
              </DataGrid>
              <TextBlock x:Name="HotkeysEmpty" Text="Ничего не найдено. Попробуй другое слово." Foreground="#908caa" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <Border Grid.Row="2" BorderBrush="#403d52" BorderThickness="0,1,0,0" Padding="0,10,0,18"><StackPanel>
              <WrapPanel Margin="0,0,0,12"><Button x:Name="ResetHotkey" Content="Сбросить выбранное" IsEnabled="False"/><Button x:Name="ResetHotkeys" Content="Сбросить все…"/></WrapPanel>
              <DockPanel><Button x:Name="SaveHotkeys" Content="Сохранить сочетания" Style="{StaticResource Primary}" DockPanel.Dock="Right" Margin="18,0,0,0" IsEnabled="False"/><TextBlock x:Name="HotkeysState" Text="Все сочетания сохранены" Foreground="#908caa" VerticalAlignment="Center"/></DockPanel>
            </StackPanel></Border>
          </Grid>
        </TabItem>
        <TabItem Header="Восстановление">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,12">
            <TextBlock Text="Восстановление" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Проверка файлов, резервные копии и возврат изменений." Style="{StaticResource Hint}" Margin="0,7,0,24"/>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Файлы компонентов" Style="{StaticResource Heading}"/><TextBlock x:Name="Health" Text="Проверка ещё не выполнялась" Foreground="#9ccfd8" Margin="0,0,0,10"/><WrapPanel><Button x:Name="CheckHealth" Content="Проверить файлы"/><Button x:Name="RestoreTaskbar" Content="Вернуть панель Windows"/></WrapPanel></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Резервные копии и откат" Style="{StaticResource Heading}"/><TextBlock Text="Копия создаётся перед изменениями. Откат возвращает предыдущую версию окружения и сохраняет текущие личные настройки." Style="{StaticResource Hint}" Margin="0,0,0,12"/>
              <TextBlock x:Name="BackupsEmpty" Text="Резервных копий пока нет" Style="{StaticResource Hint}"/><ListBox x:Name="Backups" MaxHeight="140" AutomationProperties.Name="Резервные копии"/>
              <WrapPanel><Button x:Name="OpenBackups" Content="Открыть папку копий"/><Button x:Name="Rollback" Content="Вернуть предыдущую версию…"/></WrapPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Изменённые конфиги" Style="{StaticResource Heading}"/><TextBlock x:Name="ConflictsEmpty" Text="Ручных изменений и конфликтов нет" Style="{StaticResource Hint}"/><ListBox x:Name="Conflicts" MaxHeight="150" AutomationProperties.Name="Изменённые конфиги"/><Button x:Name="Compare" Content="Сравнить выбранный файл…" HorizontalAlignment="Left" IsEnabled="False"/><TextBlock Text="Ручные правки не перезаписываются. При конфликте сначала сравни текущий файл с новой версией." Style="{StaticResource Hint}" Margin="0,12,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" BorderBrush="#eb6f92"><StackPanel><TextBlock Text="Удаление окружения" Style="{StaticResource Heading}"/><TextBlock Text="Восстановит исходные конфиги и системные настройки. Резервные копии и ранее установленные приложения сохранятся." Style="{StaticResource Hint}" Margin="0,0,0,10"/><Button x:Name="Uninstall" Content="Удалить Rose Pine Desktop…" Style="{StaticResource Danger}" HorizontalAlignment="Left"/></StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
    <Border Grid.Row="1" Background="#1f1d2e" BorderBrush="#403d52" BorderThickness="0,1,0,0" Padding="24,12"><StackPanel><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Background="#26233a" Foreground="#c4a7e7" BorderThickness="0" Visibility="Collapsed" Margin="0,0,0,8"/><ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="Status" Text="Готово" Foreground="#9ccfd8"/></ScrollViewer></StackPanel></Border>
  </Grid>
</Window>
