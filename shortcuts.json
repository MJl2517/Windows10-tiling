[
  {
    "id": "power-menu",
    "group": "Запуск",
    "title": "Открыть меню питания",
    "commands": [
      "shell-exec @PROFILE_F@/.glzr/tools/power-menu/power-menu.exe"
    ],
    "bindings": [
      "alt+escape"
    ]
  },
  {
    "id": "focus-left",
    "group": "Фокус",
    "title": "Выбрать окно слева",
    "commands": [
      "focus --direction left"
    ],
    "bindings": [
      "alt+h",
      "alt+left"
    ]
  },
  {
    "id": "focus-down",
    "group": "Фокус",
    "title": "Выбрать окно снизу",
    "commands": [
      "focus --direction down"
    ],
    "bindings": [
      "alt+j",
      "alt+down",
      "control+down"
    ]
  },
  {
    "id": "focus-up",
    "group": "Фокус",
    "title": "Выбрать окно сверху",
    "commands": [
      "focus --direction up"
    ],
    "bindings": [
      "alt+k",
      "alt+up",
      "control+up"
    ]
  },
  {
    "id": "focus-right",
    "group": "Фокус",
    "title": "Выбрать окно справа",
    "commands": [
      "focus --direction right"
    ],
    "bindings": [
      "alt+l",
      "alt+right"
    ]
  },
  {
    "id": "move-left",
    "group": "Окна",
    "title": "Переместить окно влево",
    "commands": [
      "move --direction left"
    ],
    "bindings": [
      "alt+shift+control+left"
    ]
  },
  {
    "id": "move-down",
    "group": "Окна",
    "title": "Переместить окно вниз",
    "commands": [
      "move --direction down"
    ],
    "bindings": [
      "alt+shift+control+down"
    ]
  },
  {
    "id": "move-up",
    "group": "Окна",
    "title": "Переместить окно вверх",
    "commands": [
      "move --direction up"
    ],
    "bindings": [
      "alt+shift+control+up"
    ]
  },
  {
    "id": "move-right",
    "group": "Окна",
    "title": "Переместить окно вправо",
    "commands": [
      "move --direction right"
    ],
    "bindings": [
      "alt+shift+control+right"
    ]
  },
  {
    "id": "resize-left",
    "group": "Размер",
    "title": "Сдвинуть границу влево",
    "commands": [
      "shell-exec @PROFILE_F@/.glzr/tools/resize-window/resize-window.exe left"
    ],
    "bindings": [
      "alt+control+left"
    ]
  },
  {
    "id": "resize-right",
    "group": "Размер",
    "title": "Сдвинуть границу вправо",
    "commands": [
      "shell-exec @PROFILE_F@/.glzr/tools/resize-window/resize-window.exe right"
    ],
    "bindings": [
      "alt+control+right"
    ]
  },
  {
    "id": "resize-up",
    "group": "Размер",
    "title": "Сдвинуть границу вверх",
    "commands": [
      "shell-exec @PROFILE_F@/.glzr/tools/resize-window/resize-window.exe up"
    ],
    "bindings": [
      "alt+control+up"
    ]
  },
  {
    "id": "resize-down",
    "group": "Размер",
    "title": "Сдвинуть границу вниз",
    "commands": [
      "shell-exec @PROFILE_F@/.glzr/tools/resize-window/resize-window.exe down"
    ],
    "bindings": [
      "alt+control+down"
    ]
  },
  {
    "id": "close",
    "group": "Окна",
    "title": "Закрыть активное окно",
    "commands": [
      "shell-exec @PROFILE_F@/.glzr/tools/close-window/close-window.exe"
    ],
    "bindings": [
      "alt+q"
    ]
  },
  {
    "id": "minimize",
    "group": "Окна",
    "title": "Свернуть активное окно",
    "commands": [
      "set-minimized"
    ],
    "bindings": [
      "alt+shift+q"
    ]
  },
  {
    "id": "fullscreen",
    "group": "Окна",
    "title": "Полноэкранный режим",
    "commands": [
      "toggle-fullscreen"
    ],
    "bindings": [
      "alt+f"
    ]
  },
  {
    "id": "floating",
    "group": "Окна",
    "title": "Плавающее окно / тайлинг",
    "commands": [
      "toggle-floating --centered"
    ],
    "bindings": [
      "alt+v",
      "alt+shift+space"
    ]
  },
  {
    "id": "applications",
    "group": "Запуск",
    "title": "Открыть список приложений",
    "commands": [
      "shell-exec explorer.exe shell:AppsFolder"
    ],
    "bindings": [
      "alt+r"
    ]
  },
  {
    "id": "terminal",
    "group": "Запуск",
    "title": "Открыть терминал",
    "commands": [
      "shell-exec @ROOT_F@/RosePineCenter.exe --console"
    ],
    "bindings": [
      "alt+enter",
      "alt+t"
    ]
  },
  {
    "id": "tiling-direction",
    "group": "Окна",
    "title": "Сменить направление разделения",
    "commands": [
      "toggle-tiling-direction"
    ],
    "bindings": [
      "alt+shift+b"
    ]
  },
  {
    "id": "browser",
    "group": "Запуск",
    "title": "Открыть браузер",
    "commands": [
      "shell-exec @ROOT_F@/RosePineCenter.exe --browser"
    ],
    "bindings": [
      "alt+b"
    ]
  },
  {
    "id": "files",
    "group": "Запуск",
    "title": "Открыть Yazi",
    "commands": [
      "shell-exec @ROOT_F@/RosePineCenter.exe --files"
    ],
    "bindings": [
      "alt+e"
    ]
  },
  {
    "id": "send-monitor-left",
    "group": "Мониторы",
    "title": "Перенести окно на левый монитор",
    "commands": [
      "move --workspace-in-direction left",
      "focus --monitor 0",
      "wm-redraw"
    ],
    "bindings": [
      "alt+shift+left",
      "alt+shift+oem_comma"
    ]
  },
  {
    "id": "send-monitor-right",
    "group": "Мониторы",
    "title": "Перенести окно на правый монитор",
    "commands": [
      "move --workspace-in-direction right",
      "focus --monitor 1",
      "wm-redraw"
    ],
    "bindings": [
      "alt+shift+right",
      "alt+shift+oem_period"
    ]
  },
  {
    "id": "focus-monitor-left",
    "group": "Мониторы",
    "title": "Выбрать левый монитор",
    "commands": [
      "focus --monitor 0"
    ],
    "bindings": [
      "alt+oem_comma"
    ]
  },
  {
    "id": "focus-monitor-right",
    "group": "Мониторы",
    "title": "Выбрать правый монитор",
    "commands": [
      "focus --monitor 1"
    ],
    "bindings": [
      "alt+oem_period"
    ]
  },
  {
    "id": "reload",
    "group": "Окружение",
    "title": "Перезагрузить конфигурацию",
    "commands": [
      "wm-reload-config"
    ],
    "bindings": [
      "alt+shift+r"
    ]
  },
  {
    "id": "redraw",
    "group": "Окружение",
    "title": "Перерисовать окна",
    "commands": [
      "wm-redraw"
    ],
    "bindings": [
      "alt+shift+w"
    ]
  },
  {
    "id": "exit",
    "group": "Окружение",
    "title": "Завершить GlazeWM",
    "commands": [
      "wm-exit"
    ],
    "bindings": [
      "alt+shift+e"
    ]
  },
  {
    "id": "pause",
    "group": "Окружение",
    "title": "Пауза управления окнами",
    "commands": [
      "wm-toggle-pause"
    ],
    "bindings": [
      "alt+shift+p"
    ]
  },
  {
    "id": "help",
    "group": "Окружение",
    "title": "Открыть подсказку по клавишам",
    "commands": [
      "shell-exec @ZEBAR_F@ start-widget-preset --pack hypr-dark --widget-name help --preset default"
    ],
    "bindings": [
      "alt+f1"
    ]
  },
